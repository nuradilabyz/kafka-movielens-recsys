# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_TOPIC_RATINGS=movielens.ratings.raw
KAFKA_TOPIC_TRENDING=movielens.trending.5m
KAFKA_TOPIC_ENRICHED=movielens.events.enriched
KAFKA_NUM_PARTITIONS=6

# Producer replay
SPEED_FACTOR=86400
RATINGS_START_DATE=2019-01-01
RATINGS_END_DATE=2019-02-01
RATINGS_CSV_PATH=./data/ml-32m/ratings.csv
MOVIES_CSV_PATH=./data/ml-32m/movies.csv
TAGS_CSV_PATH=./data/ml-32m/tags.csv

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=movies
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Recommender
USER_VEC_EMA_ALPHA=0.85
TOP_N_RECS=10
NEON_UPSERT_BATCH_SIZE=200
NEON_UPSERT_INTERVAL_SEC=5

# Neon Postgres (cloud)
NEON_DSN=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Streamlit (set the same NEON_DSN in Streamlit Cloud secrets)
STREAMLIT_REFRESH_SEC=5
